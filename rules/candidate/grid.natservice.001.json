{
  "schemaVersion": "1.0",
  "id": "grid.natservice.001",
  "name": "NATService Exact Service Path Pair",
  "vendor": "NeoNTech",
  "family": "network-service-candidate",
  "description": "Candidate-only correlation for the observed NATService service and its exact executable-path suffix. Valid publisher and version evidence are retained as false-positive review context and do not confirm the rule.",
  "confidence": "strong-inference",
  "status": "candidate",
  "sources": [
    "docs/evidence/M22_NATSERVICE_CANDIDATE_GAP.md",
    "docs/evidence/M22_NATSERVICE_CANDIDATE_GAP.json"
