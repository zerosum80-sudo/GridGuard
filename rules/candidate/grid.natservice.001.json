      },
      {
        "type": "serviceImagePath",
        "operator": "endsWithIgnoreCase",
        "value": "\\NAT Service\\natsvc.exe"
      }
    ]
  },
  "exclusions": [],
  "score": 60,
  "response": {
    "terminateProcess": false,
    "stopService": false,
    "disableService": false,
    "removePersistence": false,
    "quarantineFiles": false,
    "permanentDelete": false
