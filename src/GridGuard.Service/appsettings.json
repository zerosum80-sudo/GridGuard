{
  "GridGuard": {
    "Response": {
      "Mode": "AuditOnly",
      "ExplicitlyEnabled": false,
      "AllowProcessTermination": false,
      "AllowFileQuarantine": false,
      "AllowServiceChanges": false,
      "AllowPersistenceChanges": false,
      "ConfirmedScoreThreshold": 100
    },
    "ReconciliationSeconds": 30,
    "AutoRemoval": {
      "Enabled": true,
      "AuthorizedRuleId": "grid.natservice.001",
      "ServiceName": "NATService",
      "AllowedComponentPath": "%ProgramFiles(x86)%\\NAT Service\\natsvc.exe",
      "RulePath": "rules\\candidate\\grid.natservice.001.json",
      "LogPath": "%ProgramData%\\GridGuard\\logs\\auto-removal.jsonl",
      "MonitorSeconds": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
